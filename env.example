# Copy this file to `.env` (repo root) and fill in the values.

# SEC requires a valid User-Agent with contact info.
SEC_USER_AGENT="financial-forecast-foundation/1.0 (your_name@company.com)"

# FRED API key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=""

# Optional: global reference date cutoff (YYYY-MM-DD). If unset, pipelines collect up to today.
# REFERENCE_DATE="2024-12-31"

# Optional: macro download window (YYYY-MM-DD)
# FRED_OBSERVATION_START="1990-01-01"
# FRED_OBSERVATION_END=""
